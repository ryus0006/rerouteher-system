# Copy to .env and fill in. Never commit .env.

# PostgreSQL (asyncpg driver). Schema is `rerouteher`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rerouteher

# CORS: the Vite dev client origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173

# ML assets. EMBEDDING_MODEL points at the vendored model folder (loaded by path, no HF download).
EMBEDDING_MODEL=models/all-MiniLM-L6-v2
TFIDF_MODEL_PATH=ml/tfidf_logreg.joblib

# Tuning (team to finalise)
OCCUPATION_CONFIDENCE_THRESHOLD=0.65
SKILL_COSINE_THRESHOLD=0.55

# ai_exposure -> 0-1 blend weight used by the readiness formula
AI_EXPOSURE_LOW=0.2
AI_EXPOSURE_MEDIUM=0.4
AI_EXPOSURE_HIGH=0.6

# CV upload limit
MAX_CV_BYTES=10485760

# Session cookie signing secret (set a strong random value in prod)
SESSION_SECRET=dev-insecure-change-me

# E8 AI Companion (Gemini)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.1-flash-lite

# E9 role-specific job search. Keep real values in local .env/deployment secrets.
JOB_SEARCH_LOCATION=Malaysia
JOOBLE_API_KEY=
JOOBLE_API_KEY_2=
JOOBLE_BASE_URL=https://my.jooble.org/api
JOOBLE_TIMEOUT_S=20
FOUNDIT_BASE_URL=https://www.foundit.my
FOUNDIT_TIMEOUT_S=20
